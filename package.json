{
  "name": "dsh-remote-workstation",
  "version": "0.4.0",
  "description": "Mount remote SSH/SFTP directories into DeepSeek Harness workspaces: anchor workspaces, a read/write remote filesystem provider for ctx.fs with polling watch, and a Remote Explorer sidebar panel",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "ssh",
    "sftp",
    "remote-workspace",
    "remote-ssh",
    "workspace",
    "sftp-editor",
    "git-remote",
    "ai-agent",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MingTXin/dsh-remote-workstation.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test --test-force-exit test/paths.test.mjs test/mounts.test.mjs test/explorer.test.mjs test/tools.test.mjs test/fs-remote.test.mjs",
    "probe": "node scripts/probe.mjs"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-fs-local": "*",
    "@deepseek-ai/dsh-fs-sandbox": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-workspace-controller"
      ],
      "platform": "web"
    }
  },
  "bugs": {
    "url": "https://github.com/MingTXin/dsh-remote-workstation/issues"
  },
  "homepage": "https://github.com/MingTXin/dsh-remote-workstation#readme"
}
